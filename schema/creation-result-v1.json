            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Focus Element Id"
        },
        "required_element_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "type": "string"
          },
          "title": "Required Element Ids",
          "type": "array"
        },
        "preferred_element_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "type": "string"
          },
          "title": "Preferred Element Ids",
          "type": "array"
        },
        "excluded_element_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "type": "string"
          },
          "title": "Excluded Element Ids",
          "type": "array"
        },
        "excluded_reasons": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Excluded Reasons",
          "type": "object"
        },
        "constraints": {
          "items": {
            "$ref": "#/$defs/IntentConstraint"
          },
          "title": "Constraints",
          "type": "array"
        },
        "requirements": {
          "items": {
            "$ref": "#/$defs/Requirement"
          },
          "title": "Requirements",
          "type": "array"
        },
        "required_fact_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "type": "string"
          },
          "title": "Required Fact Ids",
          "type": "array"
        },
        "generation_material_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "type": "string"
          },
          "title": "Generation Material Ids",
          "type": "array"
        },
        "audit_material_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "type": "string"
          },
          "title": "Audit Material Ids",
          "type": "array"
        },
        "reference_bindings": {
          "items": {
            "$ref": "#/$defs/ReferenceBinding"
          },
          "title": "Reference Bindings",
          "type": "array"
        },
        "subject_presentations": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Subject Presentations",
          "type": "object"
        },
        "text_only_element_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "type": "string"
          },
          "title": "Text Only Element Ids",
          "type": "array"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Issues",
          "type": "array"
        }
