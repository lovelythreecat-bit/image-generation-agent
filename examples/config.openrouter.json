{
  "services": {
    "router_images": {
      "base_url": "https://openrouter.ai/api/v1",
      "protocol": "openrouter_images",
      "api_key_env": "IMAGE_AGENT_OPENROUTER_API_KEY"
    },
    "router_vision": {
      "base_url": "https://openrouter.ai/api/v1",
      "protocol": "chat_completions",
      "api_key_env": "IMAGE_AGENT_OPENROUTER_API_KEY"
    }
  },
  "image_models": {
    "pro": {"service": "router_images", "model": "google/gemini-3.1-flash-image"},
    "fast": {"service": "router_images", "model": "openai/gpt-image-2"},
    "base": {"service": "router_images", "model": "qwen/qwen-image-3-pro"}
  },
  "stages": {
    "vision": {"service": "router_vision", "model": "openai/gpt-4o-mini"}
  }
}
