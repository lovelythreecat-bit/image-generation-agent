        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "error_info": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "element_plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetElementPlan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "element_checks": {
          "items": {
            "$ref": "#/$defs/ElementCheck"
          },
          "title": "Element Checks",
          "type": "array"
        },
        "reference_bindings": {
          "items": {
            "$ref": "#/$defs/ReferenceBinding"
          },
          "title": "Reference Bindings",
          "type": "array"
        },
        "attempts": {
          "items": {
            "$ref": "#/$defs/GenerationAttempt"
          },
          "title": "Attempts",
          "type": "array"
        }
      },
      "required": [
        "asset_id",
        "platform",
        "output_type",
        "status",
        "model",
        "prompt",
        "generation_mode"
      ],
      "title": "AssetDTO",
      "type": "object"
    },
    "AssetElementPlan": {
      "additionalProperties": false,
      "properties": {
        "target_key": {
          "title": "Target Key",
