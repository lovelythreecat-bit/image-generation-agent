            "present",
            "absent",
            "not_applicable"
          ],
          "title": "Presence",
          "type": "string"
        },
        "fidelity_score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fidelity Score"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "element_id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Element Id",
          "type": "string"
        }
      },
      "required": [
        "presence",
        "fidelity_score",
        "reason",
        "element_id"
      ],
      "title": "ElementCheck",
      "type": "object"
