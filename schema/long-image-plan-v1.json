{
  "$defs": {
    "IntentConstraint": {
      "additionalProperties": false,
      "properties": {
        "constraint_id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Constraint Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "placement",
            "co_presence",
            "exclusion",
            "appearance",
            "atmosphere",
            "marketing_claim"
          ],
          "title": "Kind",
          "type": "string"
        },
        "subject_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "type": "string"
          },
          "title": "Subject Ids",
          "type": "array"
        },
        "element_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "type": "string"
          },
          "title": "Element Ids",
          "type": "array"
        },
        "instruction": {
          "minLength": 1,
          "title": "Instruction",
          "type": "string"
        },
        "source": {
          "enum": [
            "brief",
            "hint",
            "style_hint"
          ],
          "title": "Source",
          "type": "string"
        },
        "source_quote": {
          "minLength": 1,
          "title": "Source Quote",
          "type": "string"
        },
        "source_material_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Material Id"
        },
        "priority": {
          "enum": [
            "required",
            "preferred"
          ],
          "title": "Priority",
          "type": "string"
        }
      },
      "required": [
        "constraint_id",
        "kind",
        "subject_ids",
        "element_ids",
        "instruction",
        "source",
        "source_quote",
        "source_material_id",
        "priority"
      ],
      "title": "IntentConstraint",
      "type": "object"
    },
    "LongAnalysisRef": {
      "additionalProperties": false,
      "properties": {
        "analysis_id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Analysis Id",
          "type": "string"
        },
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        },
        "fingerprint": {
          "title": "Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "analysis_id",
        "content_hash",
        "fingerprint"
      ],
      "title": "LongAnalysisRef",
      "type": "object"
    },
    "LongImageRequirement": {
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "kind": {
          "default": "page_text",
          "enum": [
            "page_text",
            "section_text",
            "slot_visual"
          ],
          "title": "Kind",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/LongTextSource"
        },
        "section_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "type": "string"
          },
          "title": "Section Ids",
          "type": "array"
        },
        "slot_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "type": "string"
          },
          "title": "Slot Ids",
          "type": "array"
        },
        "order": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Order"
        },
        "occurrences": {
          "default": 1,
          "maximum": 12,
          "minimum": 1,
          "title": "Occurrences",
          "type": "integer"
        }
      },
      "required": [
        "requirement_id",
        "text",
        "source"
      ],
      "title": "LongImageRequirement",
      "type": "object"
    },
    "LongImageSection": {
      "additionalProperties": false,
      "properties": {
        "section_id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Section Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "hero",
            "image_text",
            "bullets",
            "steps",
            "table",
            "closing"
          ],
          "title": "Role",
          "type": "string"
        },
        "text_units": {
          "items": {
            "$ref": "#/$defs/LongImageTextUnit"
          },
          "title": "Text Units",
          "type": "array"
        },
        "table_rows": {
          "items": {
            "items": {
              "$ref": "#/$defs/LongImageTextUnit"
            },
            "type": "array"
          },
          "title": "Table Rows",
          "type": "array"
        },
        "slot_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "type": "string"
          },
          "title": "Slot Ids",
          "type": "array"
        }
      },
      "required": [
        "section_id",
        "role"
      ],
      "title": "LongImageSection",
      "type": "object"
    },
    "LongImageSlot": {
      "additionalProperties": false,
      "properties": {
        "slot_id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Slot Id",
          "type": "string"
        },
        "source": {
          "enum": [
            "source",
            "generate"
          ],
          "title": "Source",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "material_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "type": "string"
          },
          "title": "Material Ids",
          "type": "array"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "prompt": {
          "default": "",
          "title": "Prompt",
          "type": "string"
        },
        "aspect_ratio": {
          "anyOf": [
            {
              "enum": [
                "1:1",
                "3:4",
                "4:5",
                "9:16",
                "16:9"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aspect Ratio"
        },
        "requirement_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "type": "string"
          },
          "title": "Requirement Ids",
          "type": "array"
        },
        "section_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "type": "string"
          },
          "title": "Section Ids",
          "type": "array"
        }
      },
      "required": [
        "slot_id",
        "source",
        "role"
      ],
      "title": "LongImageSlot",
      "type": "object"
    },
    "LongImageTextUnit": {
      "additionalProperties": false,
      "properties": {
        "unit_id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Unit Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "heading",
            "body",
            "bullet",
            "cell"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/LongTextSource"
        },
        "requirement_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "type": "string"
          },
          "title": "Requirement Ids",
          "type": "array"
        }
      },
      "required": [
        "unit_id",
        "kind",
        "text"
      ],
      "title": "LongImageTextUnit",
      "type": "object"
    },
    "LongTextSource": {
      "additionalProperties": false,
      "description": "JSON Pointer plus optional Unicode-codepoint half-open source range.",
      "properties": {
        "pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pointer"
        },
        "start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "model_authored": {
          "default": false,
          "title": "Model Authored",
          "type": "boolean"
        }
      },
      "title": "LongTextSource",
      "type": "object"
    },
    "ResolvedSelection": {
      "additionalProperties": false,
      "properties": {
        "primary_subject_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Primary Subject Id"
        },
        "subject_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "type": "string"
          },
          "title": "Subject Ids",
          "type": "array"
        },
        "required_element_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "type": "string"
          },
          "title": "Required Element Ids",
          "type": "array"
        },
        "preferred_element_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "type": "string"
          },
          "title": "Preferred Element Ids",
          "type": "array"
        },
        "excluded_element_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "type": "string"
          },
          "title": "Excluded Element Ids",
          "type": "array"
        },
        "constraints": {
          "items": {
            "$ref": "#/$defs/IntentConstraint"
          },
          "title": "Constraints",
          "type": "array"
        },
        "focus_element_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "type": "string"
          },
          "title": "Focus Element Ids",
          "type": "array"
        }
      },
      "required": [
        "primary_subject_id",
        "subject_ids",
        "required_element_ids",
        "preferred_element_ids",
        "excluded_element_ids",
        "constraints",
        "focus_element_ids"
      ],
      "title": "ResolvedSelection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "planner_version": {
      "default": "1.0",
      "title": "Planner Version",
      "type": "string"
    },
    "input_fingerprint": {
      "title": "Input Fingerprint",
      "type": "string"
    },
    "scene": {
      "enum": [
        "product_detail",
        "brand_intro",
        "promotion",
        "tutorial",
        "comparison",
        "custom"
      ],
      "title": "Scene",
      "type": "string"
    },
    "theme": {
      "default": "auto",
      "enum": [
        "auto",
        "clean",
        "warm",
        "premium"
      ],
      "title": "Theme",
      "type": "string"
    },
    "visual_direction": {
      "default": "",
      "title": "Visual Direction",
      "type": "string"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/LongImageRequirement"
      },
      "title": "Requirements",
      "type": "array"
    },
    "image_slots": {
      "items": {
        "$ref": "#/$defs/LongImageSlot"
      },
      "title": "Image Slots",
      "type": "array"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/LongImageSection"
      },
      "maxItems": 12,
      "minItems": 2,
      "title": "Sections",
      "type": "array"
    },
    "analysis_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/LongAnalysisRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "resolved_selection": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResolvedSelection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "task_type": {
      "const": "long_image",
      "default": "long_image",
      "title": "Task Type",
      "type": "string"
    }
  },
  "required": [
    "input_fingerprint",
    "scene",
    "sections"
  ],
  "title": "LongImagePlanDTO",
  "type": "object"
}
