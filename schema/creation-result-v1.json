    "ConstraintCheck": {
      "additionalProperties": false,
      "properties": {
        "constraint_id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Constraint Id",
          "type": "string"
        },
        "satisfied": {
          "title": "Satisfied",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "constraint_id",
        "satisfied",
        "reason"
      ],
      "title": "ConstraintCheck",
      "type": "object"
    },
    "DetailSetAudit": {
      "additionalProperties": false,
      "properties": {
        "platform": {
          "title": "Platform",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "distinctiveness": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Distinctiveness"
        },
        "role_coverage": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Role Coverage"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "error_info": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "platform",
        "passed",
        "distinctiveness",
        "role_coverage",
        "issues",
        "reason"
      ],
      "title": "DetailSetAudit",
      "type": "object"
    },
    "Element": {
      "additionalProperties": false,
      "properties": {
        "element_id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Element Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "identity",
            "detail",
            "accessory",
            "scene",
            "style"
          ],
          "title": "Kind",
          "type": "string"
        },
        "subject_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Subject Id"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "fact_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Fact Ids",
          "type": "array"
        }
      },
      "required": [
        "element_id",
        "kind",
        "subject_id",
        "description",
        "fact_ids"
